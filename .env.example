# ============================================
# ProTrader Platform - Environment Variables
# ============================================

# Application Port (Set automatically by Vercel/Render)
PORT=3000

# MongoDB Connection String (Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/trading?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/trading?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=protrader_production_jwt_secret_key_2026_super_secure

# Token Expiry (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_S0aRTlHDRju4RM
RAZORPAY_KEY_SECRET=1oo9T8Tb0yFMdit7nU4s12Rg

# Optional Market Data API Keys (Fallback demo data will be used if omitted)
# TWELVEDATA_API_KEY=
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=

# AI Chatbot Backend URL (If deploying chatbot backend separately on Render/Railway)
# CHATBOT_API_URL=https://your-chatbot-backend.onrender.com
